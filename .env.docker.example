# Docker-backed runtime profile (optional Postgres persistence).
#
# Copy to `.env` for a Docker-backed deployment. Requires the compose stack
# to be up (docker compose up -d --build) so Postgres is reachable at
# localhost:5432. Ollama still runs on the host.
#
# Only variables actually used by the project are listed here.

# Run in docker mode: enhanced Postgres persistence via the compose stack.
RUNTIME_MODE=docker

# Postgres DSN for the compose `postgres` service (matching docker-compose.yml).
POSTGRES_DSN=postgresql+psycopg://jarvis:jarvis@localhost:5432/jarvis

# Embedded ChromaDB vector store stays local (no Docker service exists).
VECTOR_DB_PATH=./data/vector_store

# Folder scanned by `jarvis ingest` for .txt/.md documents.
DOCS_FOLDER=./data/docs

# Model server runs on the host (backend talks to it via host.docker.internal
# when itself containerized).
OLLAMA_BASE_URL=http://localhost:11434

# --- Deployment (Phase 7) ---
# Docker deployments are typically single_host (private machine) or
# production (public). Loopback defaults are overridden here because the
# backend is containerized and served through the compose stack.
DEPLOYMENT_PROFILE=single_host
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
# Set these for single_host/production: explicit browser origins and a
# host-header allowlist. Wildcard CORS is rejected by validation.
JARVIS_ALLOWED_ORIGINS=
JARVIS_TRUSTED_HOSTS=localhost,127.0.0.1
JARVIS_BEHIND_REVERSE_PROXY=true
JARVIS_FORCE_HTTPS=false
JARVIS_DEBUG=false
JARVIS_EXPOSE_TRACES=false
# Production validation requires backups to be enabled.
JARVIS_BACKUP_ENABLED=true
BACKUP_DIR=./backups
BACKUP_INCLUDE_DOCUMENTS=false
BACKUP_RETENTION_DAYS=30