# Local-only runtime profile (no Docker required).
#
# Copy to `.env` (or rename) for a lightweight local deployment:
#   SQLite persistence + embedded ChromaDB + in-process tasks.
#
# Only variables actually used by the project are listed here.

# Run in local mode: SQLite + embedded vector store, no Docker services.
RUNTIME_MODE=local

# Empty DSN => the app falls back to the local SQLite file below. Postgres
# is NOT used in local mode.
POSTGRES_DSN=
SQLITE_PATH=./data/jarvis.db

# Embedded ChromaDB vector store (local directory, no service).
VECTOR_DB_PATH=./data/vector_store

# Folder scanned by `jarvis ingest` for .txt/.md documents.
DOCS_FOLDER=./data/docs

# Model server still runs on the host (never inside Docker).
OLLAMA_BASE_URL=http://localhost:11434