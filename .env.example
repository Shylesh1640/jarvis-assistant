# Local model server
OLLAMA_BASE_URL=http://localhost:11434

# Local model names (match your `ollama list` output)
GENERAL_MODEL=qwen3:8b
STRONG_LOCAL_MODEL=qwen3:14b
CODING_MODEL=qwen3-coder:30b        # strong local coder (medium/difficult)
CODING_MODEL_SMALL=qwen2.5-coder:7b  # small local coder (easy)
EMBEDDING_MODEL=qwen3-embedding:latest

# When False, general branch always uses GENERAL_MODEL even for medium/difficult
# (useful on hardware that cannot comfortably run STRONG_LOCAL_MODEL).
USE_STRONG_LOCAL=true

# Cloud fallback (optional)
OPENROUTER_API_KEY=your_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
COMPLEX_MODEL_CHAIN=anthropic/claude-opus-4.1,openai/gpt-5.5,google/gemini-2.5-pro

# App
APP_ENV=development
LOG_LEVEL=INFO
VECTOR_DB_PATH=./data/vector_store

# --- Coding toolset ---
# Root directory that write_file / edit_file / run_shell may operate inside.
# Anything that escapes this folder via absolute paths or ".." is refused.
WORKSPACE_DIR=./workspace
# Comma-separated allowlist of shell commands run_shell will accept.
SHELL_ALLOWED_COMMANDS=ls,dir,cat,type,echo,git,pytest,python -m pytest,ruff,pip,uv,npm,npm run build,npm test
# Wall-clock cap (seconds) for run_tests / run_shell subprocesses.
TOOL_SUBPROCESS_TIMEOUT=120

# --- Persistence ---
# Postgres DSN. Leave empty to fall back to a local SQLite file (data/jarvis.db)
# so the app runs without Docker. With Docker, use:
#   postgresql+psycopg://jarvis:jarvis@localhost:5432/jarvis
POSTGRES_DSN=
SQLITE_PATH=./data/jarvis.db
# Summarize a conversation after this many (user, assistant) turns.
SUMMARY_EVERY_TURNS=10

# --- UI / request toggles ---
# One of: "" | concise | detailed | code  ("" = no style directive)
DEFAULT_ANSWER_STYLE=
DEFAULT_SHOW_REASONING=false
