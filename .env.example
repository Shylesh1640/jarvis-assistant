# Local model server
OLLAMA_BASE_URL=http://localhost:11434

# Local model names (match your `ollama list` output).
# Quantization tags are explicit so models run purely in GPU VRAM:
#   qwen3:8b                -> default Q4_K_M
#   qwen2.5-coder:7b-q5_K_M -> 5-bit Q5_K_M (syntax integrity for coding)
#   qwen3:14b               -> default Q4_K_M (medium/difficult general)
GENERAL_MODEL=qwen3:8b
STRONG_LOCAL_MODEL=qwen3:14b
CODING_MODEL=qwen2.5-coder:7b-q5_K_M
CODING_MODEL_SMALL=qwen2.5-coder:7b-q5_K_M
EMBEDDING_MODEL=qwen3-embedding:latest

# Optional small model for the intent router (JSON mode). Empty = reuse
# GENERAL_MODEL. Only fired on borderline prompts (medium-length, no keyword).
# ROUTER_MODEL=
# Set to false to classify purely by rules (no extra router LLM call).
# ROUTER_LLM_ENABLED=true

# When False, general branch always uses GENERAL_MODEL even for medium/difficult
# (useful on hardware that cannot comfortably run STRONG_LOCAL_MODEL).
USE_STRONG_LOCAL=true

# Cloud fallback (optional)
OPENROUTER_API_KEY=your_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
COMPLEX_MODEL_CHAIN=anthropic/claude-opus-4.1,openai/gpt-5.5,google/gemini-2.5-pro

# App
APP_ENV=development
LOG_LEVEL=INFO
VECTOR_DB_PATH=./data/vector_store

# --- Coding toolset ---
# Root directory that write_file / edit_file / run_shell may operate inside.
# Anything that escapes this folder via absolute paths or ".." is refused.
WORKSPACE_DIR=./workspace
# Comma-separated allowlist of shell commands run_shell will accept.
# Commands must START with an allowlisted entry (token-prefix match), so
# "python -m pytest" grants `python -m pytest tests/...` but NOT `python -c ...`.
SHELL_ALLOWED_COMMANDS=ls,dir,cat,type,echo,git,pytest,python -m pytest,ruff,pip,uv,npm,npm run build,npm test
# Wall-clock cap (seconds) for run_tests / run_shell subprocesses.
TOOL_SUBPROCESS_TIMEOUT=120
# Max LLM tool-loop rounds per turn (general/coding branches) before the
# graph stops and asks you to continue.
MAX_TOOL_ITERATIONS=5
# How long a pending tool approval stays valid before it expires (seconds).
APPROVAL_TTL_SECONDS=600

# --- Error handling / retry ---
# Retries for transient Ollama failures (server restart, timeout). 1 = off.
RETRY_MAX_ATTEMPTS=3
# Base backoff between retries (grows linearly); seconds.
RETRY_BACKOFF_SECONDS=1.0
# When an OOM occurs under full GPU offload, retry once on CPU (num_gpu=0).
GPU_FALLBACK_TO_CPU=true

# --- Security ---
# Requests per minute per session (or IP). 0 disables rate limiting.
RATE_LIMIT_PER_MINUTE=300
# Require the per-session bearer token (issued via GET /sessions/{id}/token)
# on /chat and /tasks, blocking cross-session access.
REQUIRE_SESSION_TOKEN=false
# Emit JSON logs for easy parsing (false = human-readable console).
JSON_LOGS_ENABLED=false

# --- Persistence ---
# Runtime mode: local | docker | auto.
#   local  = lightweight local runtime (SQLite + embedded vector store, tasks
#            in-process). No Docker required. Default.
#   docker = Docker-backed persistence (Postgres) / containerized deployment.
#            Adds optional Postgres; requires POSTGRES_DSN below.
#   auto   = prefer local; use Docker-backed services only when configured
#            and reachable.
RUNTIME_MODE=local
# Postgres DSN. Leave empty to fall back to a local SQLite file (data/jarvis.db)
# so the app runs without Docker. With Docker, use:
#   postgresql+psycopg://jarvis:jarvis@localhost:5432/jarvis
POSTGRES_DSN=
SQLITE_PATH=./data/jarvis.db
# Summarize a conversation after this many (user, assistant) turns.
SUMMARY_EVERY_TURNS=10
# --- Maintenance / cleanup ---
# Delete sessions inactive for this many days (0 disables).
SESSION_TTL_DAYS=7
# Hard-delete expired approval rows after this many hours (0 = next sweep).
EXPIRED_APPROVAL_RETENTION_HOURS=24
# How often the periodic maintenance sweep runs (seconds; 0 disables).
MAINTENANCE_SWEEP_INTERVAL=300

# --- UI / request toggles ---
# One of: "" | concise | detailed | code  ("" = no style directive)
DEFAULT_ANSWER_STYLE=
DEFAULT_SHOW_REASONING=false

# --- GPU / Ollama runtime optimization (pure-GPU execution) ---
# These do NOT change your model. Master switch for request-level options:
GPU_OPTIMIZATION_ENABLED=true
# GPU offload layer count. -1 = offload EVERY layer -> 100% GPU, never spills
# into system RAM. If a model exceeds VRAM, Ollama errors instead of spilling.
OLLAMA_NUM_GPU=-1
# Context window size sent per request. 8192 balances history/RAG room against
# KV cache VRAM. Reduce if VRAM pressure is high; raise only if it fits.
OLLAMA_CONTEXT_LENGTH=8192
# Prompt processing batch size per request.
OLLAMA_NUM_BATCH=512
# Flash attention (1 on / 0 off). Requires Ollama >= 0.5.
OLLAMA_FLASH_ATTENTION=1
# KV cache quantization: q8_0 | q4_0 | q4_1 | f16 | f32 . "q8_0" halves KV cache.
OLLAMA_KV_CACHE_TYPE=q8_0
# How long a model stays in VRAM after the last request: "5m", "30s", "0".
OLLAMA_KEEP_ALIVE=5m
# SERVER-SIDE Ollama env vars (set on `ollama serve`, shown here for reference):
#   OLLAMA_NUM_PARALLEL=1            (max concurrent requests Ollama serves)
#   OLLAMA_MAX_LOADED_MODELS=1       (max models loaded simultaneously)
# The app serializes local generation regardless; these are surfaced in
# diagnostics/validation only.
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
# Soft caps (tokens, word-count proxy) on RAG context + selected text so a
# large hit or giant paste cannot dominate the model context window.
RAG_CONTEXT_TOKEN_CAP=2048
SELECTED_TEXT_TOKEN_CAP=1024
# Relevance gate for automatic RAG injection. Chroma cosine DISTANCE: only
# chunks closer than this are injected (0 = disabled). Calibrated for
# qwen3-embedding (relevant ~0.05-0.35, irrelevant ~0.6+). Prevents Jarvis
# answering from an irrelevant stored chunk instead of the user's question.
RAG_RELEVANCE_THRESHOLD=0.5

# --- RAG quality (Phase 5) ---
# Master switch for the whole RAG pipeline (querying + context injection).
RAG_ENABLED=true
# Minimum relevance SCORE (similarity 0..1, ~0.5 for qwen3-embedding) before
# a chunk is injected. 0 disables the gate. Takes precedence over the legacy
# RAG_RELEVANCE_THRESHOLD when set to a non-default value.
RAG_MIN_RELEVANCE_SCORE=0.5
# Hybrid rerank weights (vector vs keyword). When both are set they are
# normalized together; when only one is set it wins; when neither is set the
# legacy RERANK_KEYWORD_WEIGHT is honoured.
# RAG_VECTOR_WEIGHT=
# RAG_KEYWORD_WEIGHT=
# RERANK_KEYWORD_WEIGHT=0.3
# Set false to disable keyword (BM25) reranking entirely (vector-only).
# RAG_RERANK_ENABLED=true
# Max chunks pulled from a single source per query (0 = unlimited).
RETRIEVAL_PER_SOURCE_LIMIT=0

# --- Conversation memory (Phase 5) ---
# The summarizer keeps earlier turns available beyond the sliding window.
# Summaries are stored in the DB + Chroma and surfaced via GET /memory.
# (SUMMARY_EVERY_TURNS above controls how often they are written.)

# --- Planning (Phase 5) ---
# Max steps a background-task plan may contain (0 = no planning node).
MAX_PLAN_STEPS=8
# Hard wall-clock cap for a single background task in seconds (0 = unlimited).
MAX_TASK_DURATION_SECONDS=0

# --- Cloud cost guardrails (Phase 7) ---
# Estimated prompt-token ceiling before a cloud call is allowed. 0 = unlimited.
# Prompts over this cap fall back to local models.
# CLOUD_MAX_PROMPT_TOKENS=0
# Rough daily cloud-spend budget in USD. 0 = unlimited. When reached, cloud
# calls fall back to local models until the next UTC day.
# CLOUD_DAILY_BUDGET_USD=0.0

# --- Background auto-reindex (off by default) ---
# When true, the ingest endpoints/CLI prefer full re-ingest semantics and a
# future incremental file watcher becomes available. Keeping it off avoids
# extra I/O when the RAG store is static.
AUTO_REINDEX_ENABLED=false
# Polling interval (seconds) for a background file watcher when enabled.
AUTO_REINDEX_INTERVAL=300
